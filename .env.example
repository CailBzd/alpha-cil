# Supabase (region: fra1 / EU)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Exposed to the browser client (must mirror the two vars above)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Transactional email (Resend — https://resend.com/api-keys)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Shared secret checked against the Authorization header on /api/cron/*
# routes, so only the scheduler (Vercel Cron in production) can trigger them.
CRON_SECRET=

# AI devis comparison (Mistral — https://console.mistral.ai/api-keys)
MISTRAL_API_KEY=
